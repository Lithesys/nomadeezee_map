# GitHub Actions secrets for .github/workflows/publish-map.yml
#
# This file is a checklist only. Replace each placeholder in GitHub:
# Settings -> Secrets and variables -> Actions -> New repository secret.
# Never commit real credentials, private keys, or service-role tokens.

# Source data URLs
VIETNAM_OSM_PBF_URL=https://replace-with-vietnam-osm-pbf-url
WORLD_GEOJSON_URL=https://replace-with-world-geojson-url
GLYPHS_ARCHIVE_URL=https://replace-with-glyphs-archive-url

# SHA-256 checksums for the downloaded source files (lowercase hexadecimal)
VIETNAM_OSM_PBF_SHA256=replace-with-vietnam-osm-pbf-sha256
WORLD_GEOJSON_SHA256=replace-with-world-geojson-sha256
GLYPHS_ARCHIVE_SHA256=replace-with-glyphs-archive-sha256

# Supabase
SUPABASE_URL=https://replace-with-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
MAP_ACTOR_ID=replace-with-admin-user-uuid

# Cloudflare R2
TILES_BASE_URL=https://tiles.map.nomadeezee.com
R2_BUCKET=replace-with-r2-bucket-name
R2_ACCESS_KEY_ID=replace-with-r2-access-key-id
R2_SECRET_ACCESS_KEY=replace-with-r2-secret-access-key
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id

# Workflow dispatch inputs are supplied when the workflow is run and are not secrets:
# job_id, release_id, release_key, expected_generation
# NODE_VERSION and PLANETILER_IMAGE are repository workflow configuration values.
